#!/bin/sh
# configure.win -- Windows counterpart of ./configure (run by R via the Rtools
# sh). src/ carries copies of the engine's CPU sources; inside the monorepo they
# are refreshed from ../native/ (the source of truth), normalised to LF.
set -e
SRC=src
NATIVE=""
for d in ../native ../../native; do
  if [ -f "$d/libcusna_saom_cpu.cpp" ]; then NATIVE="$d"; break; fi
done
if [ -n "$NATIVE" ]; then
  for f in libcusna.h libcusna_saom_cpu.cpp libcusna_ergm_cpu.cpp; do
    tr -d '\r' < "$NATIVE/$f" > "$SRC/$f.tmp"
    if [ -f "$SRC/$f" ] && cmp -s "$SRC/$f.tmp" "$SRC/$f"; then
      rm -f "$SRC/$f.tmp"
    else
      mv "$SRC/$f.tmp" "$SRC/$f"
      echo "cusna: refreshed src/$f from $NATIVE"
    fi
  done
elif [ ! -f "$SRC/libcusna_saom_cpu.cpp" ]; then
  echo "cusna: ERROR -- native sources not found in src/ or ../native/." >&2
  exit 1
fi
echo "cusna: building the CPU backend (C++17, OpenMP where available)."
exit 0
